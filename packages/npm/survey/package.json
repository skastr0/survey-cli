  "repository": {
    "type": "git",
    "url": "git+https://github.com/skastr0/survey-cli.git",
    "directory": "packages/npm/survey"
  },
  "homepage": "https://github.com/skastr0/survey-cli#readme",
  "bugs": {
    "url": "https://github.com/skastr0/survey-cli/issues"
  },
  "keywords": [
    "survey",
    "cli",
    "search",
    "research",
    "exa",
    "firecrawl",
    "parallel",
    "keenable",
    "llamacloud",
    "tinyfish",
    "mcp",
    "agents",
    "pdf",
    "bun"
  ],
  "publishConfig": {
    "access": "public"
  },
  "bin": {
