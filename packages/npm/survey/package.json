    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "optionalDependencies": {
    "@skastr0/survey-darwin-arm64": "0.1.5",
    "@skastr0/survey-darwin-x64": "0.1.5",
    "@skastr0/survey-linux-arm64": "0.1.5",
    "@skastr0/survey-linux-x64": "0.1.5",
    "@firecrawl/anydoc": "0.2.4",
